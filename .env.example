# local 프로필은 기본값(root/root, localhost:3306)을 사용하므로 보통 .env가 필요 없습니다.
# dev/prod 배포 시 아래 값을 실제 값으로 채운 .env 파일을 만들어 사용하세요. (.env는 절대 커밋 금지)
DB_URL=jdbc:mysql://<host>:3306/certimate_manager?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Seoul
DB_USERNAME=
DB_PASSWORD=

# JWT 서명 키. local 프로필은 기본값이 있어 생략 가능하지만 dev/prod는 반드시 재정의하세요.
JWT_SECRET=
JWT_EXPIRATION_MS=3600000

# 카카오 로그인 (REST API 키). 값이 없으면 카카오 로그인만 실패하고 나머지 기능은 정상 동작합니다.
KAKAO_CLIENT_ID=
KAKAO_REDIRECT_URI=

# 구글 로그인. Google Cloud Console에서 OAuth 클라이언트(웹) 발급 후 채우세요.
# 승인된 리디렉션 URI는 프론트의 http://localhost:5173/auth/google/callback 과 일치해야 합니다.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5173/auth/google/callback

# AI 해설 생성 (Anthropic Claude). 값이 없으면 AI 해설 생성만 실패하고 나머지는 정상 동작합니다.
# console.anthropic.com 에서 API 키 발급 후 넣으세요. (커밋 금지)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5
